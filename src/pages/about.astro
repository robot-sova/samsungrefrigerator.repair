---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import Photo from '../components/Photo.astro';
import { business, disclaimer, prices, usd, warranty } from '../data/business';
import { COUNTIES } from '../data/locations';
---
<Base
  title="About Us | Independent Samsung Refrigerator Repair, SoCal"
  description="Independent in-home Samsung refrigerator repair across seven Southern California counties: how we work, what we charge, what we guarantee."
  crumbs={[{ label: 'About' }]}
  ogPhoto="arrival-01"
>
  <section class="section">
    <div class="wrap split">
      <div class="prose">
        <h1>About us</h1>
        <p class="lede">We repair Samsung refrigerators in people's kitchens across Southern California. That narrow focus is the whole point.</p>
        <p>Samsung refrigerators fail in a handful of well-known ways: frosted evaporator coils from a stopped defrost cycle, ice makers that freeze solid in the fridge-door ice room, evaporator fans that wear out, inverter boards that stop starting the compressor. A technician who sees those every week tests the right part first — and does not sell you a compressor for a twenty-dollar sensor.</p>
        <h2>How we work</h2>
        <ul>
          <li>The diagnostic visit is {usd(prices.diagnostic)}, credited toward the repair if you go ahead.</li>
          <li>You get one price for the repair — parts and labor — before any work starts. If a repair is not worth it on an older unit, we say so.</li>
          <li>{warranty.covers}</li>
          <li>Hours: {business.hours.display}. The online form takes requests any time.</li>
          <li>Service area: {COUNTIES.map((c) => c.name).join(', ')}.</li>
        </ul>
        <h2>Independent, not Samsung</h2>
        <p>{disclaimer} If your refrigerator is still under the Samsung factory warranty, contact Samsung first — the repair may cost you nothing through them.</p>
      </div>
      <Photo id="parts-01" />
    </div>
  </section>
  <LeadForm />
</Base>
