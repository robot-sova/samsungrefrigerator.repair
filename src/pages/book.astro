---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import TrustRow from '../components/TrustRow.astro';
import Photo from '../components/Photo.astro';
import { business, prices, usd, warranty } from '../data/business';
---
<Base
  title="Book Samsung Refrigerator Repair | Same-Day Technician"
  description={`Book an in-home Samsung refrigerator repair in Southern California. ${usd(prices.diagnostic)} diagnostic visit credited to the repair, ${warranty.days}-day warranty.`}
  crumbs={[{ label: 'Book a repair' }]}
>
  <section class="section top">
    <div class="wrap">
      <h1>Book a Samsung refrigerator repair</h1>
      <p class="lede">Send the form and a dispatcher calls you back to set the arrival window. Faster still: call <a href={`tel:${business.phone.tel}`}>{business.phone.display}</a>.</p>
      <TrustRow />
    </div>
  </section>
  <LeadForm heading="Tell us what the fridge is doing" />
  <section class="section">
    <div class="wrap split">
      <div class="prose">
        <h2>Before the technician arrives</h2>
        <ul>
          <li>Find the model number on the sticker inside the fridge, on the left wall or the ceiling of the fresh-food section.</li>
          <li>If food is at risk, move it to a cooler with ice; a full freezer stays frozen longer with the door shut.</li>
          <li>Clear a little floor space in front of the refrigerator — some repairs mean pulling it out from the wall.</li>
          <li>Note any code on the display, and whether it blinks.</li>
        </ul>
      </div>
      <Photo id="parts-01" />
    </div>
  </section>
</Base>

<style>
  .top { padding-top: 24px; }
  .top :global(.trust) { margin-top: 20px; }
</style>
