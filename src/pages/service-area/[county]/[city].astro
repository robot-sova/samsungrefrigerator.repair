---
import Base from '../../../layouts/Base.astro';
import Photo from '../../../components/Photo.astro';
import LeadForm from '../../../components/LeadForm.astro';
import TrustRow from '../../../components/TrustRow.astro';
import Faq from '../../../components/Faq.astro';
import { COUNTIES, type County, type City } from '../../../data/locations';
import { CITY_CONTENT } from '../../../data/cityContent';
import { SERVICES } from '../../../data/services';
import { serviceLabel } from '../../../data/extras';
import { business, fill, prices, usd } from '../../../data/business';
import { faqSchema, serviceSchema } from '../../../data/schema';
import type { PhotoId } from '../../../data/photos';

export function getStaticPaths() {
  // Only counties with real city content get city pages (see locations.ts, cityPages).
  return COUNTIES.filter((c) => c.cityPages !== false).flatMap((county) =>
    county.cities.map((city) => ({ params: { county: county.slug, city: city.slug }, props: { county, city } })),
  );
}

const { county, city } = Astro.props as { county: County; city: City };
const key = `${county.slug}/${city.slug}`;
const content = CITY_CONTENT[key];
if (!content) throw new Error(`no city content for ${key} — write it before adding the city`);

const path = `/service-area/${key}/`;
const description = fill(content.metaDescription);
const nearby = (content.nearbySlugs ?? [])
  .map((slug) => county.cities.find((c) => c.slug === slug))
  .filter((c): c is City => Boolean(c));
// Rotate the side photo so neighbouring city pages do not all look the same.
const sidePhotos: PhotoId[] = ['evaporator-01', 'icemaker-01', 'compressor-01', 'gasket-01', 'board-01', 'drain-01'];
const side = sidePhotos[[...city.slug].reduce((n, ch) => n + ch.charCodeAt(0), 0) % sidePhotos.length];
const faq = [
  {
    q: `Do you offer same-day Samsung refrigerator repair in ${city.name}?`,
    a: `Yes, for most calls that reach us before noon; otherwise next-day. We work ${business.hours.display}.`,
  },
  {
    q: `How much is the service call in ${city.name}?`,
    a: `${usd(prices.diagnostic)} for the diagnostic visit, credited toward the repair if you go ahead. You get one price for the repair before any work starts.`,
  },
  {
    q: `Which Samsung refrigerators do you service in ${city.name}?`,
    a: 'Family Hub, Bespoke, French Door and 4-Door Flex, side-by-side and top-freezer models. Have the model number from the sticker inside the fridge ready when you call so we can check parts.',
  },
];
---
<Base
  title={fill(content.titleTag)}
  description={description}
  crumbs={[{ label: 'Service area', href: '/service-area/' }, { label: county.name, href: `/service-area/${county.slug}/` }, { label: city.name }]}
  schema={[serviceSchema({ name: `Samsung refrigerator repair in ${city.name}, CA`, description, path, area: `${city.name}, CA` }), faqSchema(faq)]}
>
  <section class="section top">
    <div class="wrap">
      <div class="eyebrow">{county.name}</div>
      <h1>Samsung Refrigerator Repair in {city.name}, CA</h1>
      <div class="btn-row">
        <a class="btn btn-primary" href="#book">Book a technician</a>
        <a class="btn" href={`tel:${business.phone.tel}`}>Call {business.phone.display}</a>
      </div>
      <div class="trust"><TrustRow /></div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap split">
      <div class="prose">
        {content.paragraphs.map((p) => <p>{fill(p)}</p>)}
      </div>
      <Photo id={side} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Samsung repairs we do in {city.name}</h2>
      <ul class="chips">
        {SERVICES.map((s) => <li><a href={`/services/${s.slug}/`}>{serviceLabel(s.slug)}</a></li>)}
      </ul>
      {nearby.length > 0 && (
        <>
          <h2 class="mt">Nearby cities</h2>
          <ul class="chips">
            {nearby.map((n) => <li><a href={`/service-area/${county.slug}/${n.slug}/`}>{n.name}</a></li>)}
          </ul>
        </>
      )}
    </div>
  </section>

  <Faq items={faq} />
  <LeadForm eyebrow={`${city.name}, CA`} heading={`Book a technician in ${city.name}`} />
</Base>

<style>
  .top { padding-top: 24px; }
  .trust { margin-top: 28px; }
  .mt { margin-top: 1.4em; }
</style>
