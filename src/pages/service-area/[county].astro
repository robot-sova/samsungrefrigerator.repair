---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import LeadForm from '../../components/LeadForm.astro';
import TrustRow from '../../components/TrustRow.astro';
import Faq from '../../components/Faq.astro';
import { COUNTIES, type County } from '../../data/locations';
import { SERVICES } from '../../data/services';
import { serviceLabel } from '../../data/extras';
import { business, prices, usd, warranty } from '../../data/business';
import { faqSchema, serviceSchema } from '../../data/schema';

export function getStaticPaths() {
  return COUNTIES.map((county) => ({ params: { county: county.slug }, props: { county } }));
}

const { county } = Astro.props as { county: County };
const path = `/service-area/${county.slug}/`;
const description = `Samsung refrigerator repair in ${county.name}, CA — in your home, same-day for most morning calls. ${usd(prices.diagnostic)} diagnostic, ${warranty.days}-day warranty.`;
const faq = [
  {
    q: `Do you charge extra to come to ${county.name}?`,
    a: `No. The diagnostic visit is ${usd(prices.diagnostic)} anywhere in ${county.name}, and it is credited toward the repair if you go ahead.`,
  },
  {
    q: `How soon can a technician come in ${county.name}?`,
    a: `Same-day for most calls that reach us before noon, otherwise next-day. We work ${business.hours.display}.`,
  },
];
---
<Base
  title={`Samsung Refrigerator Repair in ${county.name}, CA`}
  description={description}
  crumbs={[{ label: 'Service area', href: '/service-area/' }, { label: county.name }]}
  schema={[serviceSchema({ name: `Samsung refrigerator repair in ${county.name}`, description, path, area: `${county.name}, CA` }), faqSchema(faq)]}
>
  <section class="section top">
    <div class="wrap split">
      <div>
        <div class="eyebrow">Service area</div>
        <h1>Samsung Refrigerator Repair in {county.name}</h1>
        <p class="lede">{county.intro}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="#book">Book a technician</a>
          <a class="btn" href={`tel:${business.phone.tel}`}>Call {business.phone.display}</a>
        </div>
      </div>
      <Photo id="arrival-01" eager />
    </div>
    <div class="wrap trust"><TrustRow /></div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <h2>Cities in {county.name}</h2>
      <ul class="chips">
        {county.cities.map((ct) =>
          county.cityPages === false
            ? <li><span>{ct.name}</span></li>
            : <li><a href={`/service-area/${county.slug}/${ct.slug}/`}>{ct.name}</a></li>
        )}
      </ul>
      {county.cityPages === false && <p class="note more">Not on the list? Call — if you are in {county.name}, we most likely cover you.</p>}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>What we fix in {county.name}</h2>
      <ul class="chips">
        {SERVICES.map((s) => <li><a href={`/services/${s.slug}/`}>{serviceLabel(s.slug)}</a></li>)}
      </ul>
    </div>
  </section>

  <Faq items={faq} />
  <LeadForm eyebrow={county.name} heading={`Book a technician in ${county.name}`} />
</Base>

<style>
  .top { padding-top: 24px; }
  .trust { margin-top: 28px; }
  .more { margin-top: 14px; }
</style>
