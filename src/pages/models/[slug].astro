---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import LeadForm from '../../components/LeadForm.astro';
import Faq from '../../components/Faq.astro';
import { MODELS, type Model } from '../../data/models';
import { modelPhoto } from '../../data/extras';
import { business, fill, formTypes, prices, usd } from '../../data/business';
import { faqSchema, serviceSchema, paras } from '../../data/schema';

export function getStaticPaths() {
  return MODELS.map((m) => ({ params: { slug: m.slug }, props: { m } }));
}

const { m } = Astro.props as { m: Model };
const path = `/models/${m.slug}/`;
const short = m.title.replace(/^Samsung /, '').replace(/ (Refrigerator )?Repair$/, '');
let description = `${m.title} in your home across Southern California: common failures, typical repairs and what they involve. ${usd(prices.diagnostic)} diagnostic visit.`;
if (description.length > 160) description = `${m.title} in your home across Southern California: common failures and typical repairs. ${usd(prices.diagnostic)} diagnostic.`;
const typeFor: Record<string, (typeof formTypes)[number]> = {
  'family-hub': 'Family Hub (touchscreen)',
  bespoke: 'Bespoke',
  'french-door-4-door-flex': 'French Door (3 or 4 door)',
  'side-by-side': 'Side-by-side',
  'top-freezer': 'Top or bottom freezer',
};
const faq = m.faq.map((f) => ({ q: fill(f.q), a: fill(f.a) }));
const others = MODELS.filter((o) => o.slug !== m.slug);
---
<Base
  title={`${m.title} | In-Home Service in SoCal`.length > 70 ? `${m.title} in SoCal` : `${m.title} | In-Home Service in SoCal`}
  description={description}
  ogPhoto={modelPhoto[m.slug]}
  crumbs={[{ label: 'Models', href: '/models/' }, { label: short }]}
  schema={[serviceSchema({ name: m.title, description, path }), faqSchema(faq)]}
>
  <section class="section top">
    <div class="wrap split">
      <div>
        <div class="eyebrow">Samsung refrigerator models</div>
        <h1>{m.title}</h1>
        <p class="lede">{fill(m.description)}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="#book">Book a technician</a>
          <a class="btn" href={`tel:${business.phone.tel}`}>Call {business.phone.display}</a>
        </div>
      </div>
      <Photo id={modelPhoto[m.slug]} eager />
    </div>
  </section>

  <section class="section alt">
    <div class="wrap prose">
      {paras(fill(m.longIntro)).map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="section">
    <div class="wrap grid grid-2">
      <div class="card">
        <h2 class="h3">Common problems</h2>
        <ul>{m.commonIssues.map((x) => <li>{fill(x)}</li>)}</ul>
      </div>
      <div class="card">
        <h2 class="h3">Typical repairs</h2>
        <ul>{m.typicalRepairs.map((x) => <li>{fill(x)}</li>)}</ul>
      </div>
    </div>
  </section>

  <Faq items={faq} />

  <section class="section alt">
    <div class="wrap">
      <h2>Other Samsung styles we repair</h2>
      <ul class="chips">
        {others.map((o) => <li><a href={`/models/${o.slug}/`}>{o.title.replace(/^Samsung /, '').replace(/ (Refrigerator )?Repair$/, '')}</a></li>)}
      </ul>
    </div>
  </section>

  <LeadForm heading={`Book ${short} repair`} fridgeType={typeFor[m.slug]} />
</Base>

<style>
  .top { padding-top: 24px; }
  .h3 { font-size: 1.2rem; }
  .card ul { padding-left: 1.1em; margin: 0; }
  .card li { margin-bottom: .35em; }
</style>
