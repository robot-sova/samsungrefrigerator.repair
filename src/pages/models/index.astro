---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import LeadForm from '../../components/LeadForm.astro';
import { MODELS } from '../../data/models';
import { modelPhoto } from '../../data/extras';
import { fill } from '../../data/business';
---
<Base
  title="Samsung Fridge Models We Repair: Family Hub, Bespoke, French Door"
  description="In-home repair for every Samsung refrigerator style: Family Hub, Bespoke, French Door and 4-Door Flex, side-by-side and top-freezer models."
  crumbs={[{ label: 'Models' }]}
>
  <section class="section">
    <div class="wrap">
      <h1>Samsung refrigerator models we repair</h1>
      <p class="lede">Different styles fail in different places. Find yours to see what usually goes wrong and how it is fixed.</p>
      <div class="grid grid-3">
        {MODELS.map((m) => (
          <a class="card pcard" href={`/models/${m.slug}/`}>
            <Photo id={modelPhoto[m.slug]} sizes="(min-width: 900px) 33vw, 100vw" />
            <h2 class="h3">{m.title.replace(/^Samsung /, '').replace(/ (Refrigerator )?Repair$/, '')}</h2>
            <p class="note">{fill(m.description)}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  <LeadForm />
</Base>

<style>
  .grid { margin-top: 20px; }
  .pcard { padding: 0; overflow: hidden; }
  .pcard :global(img) { border-radius: 0; aspect-ratio: 4 / 3; object-fit: cover; }
  .pcard .h3 { font-size: 1.15rem; padding: 14px 16px 0; }
  .pcard p { padding: 0 16px 16px; }
</style>
