---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import LeadForm from '../../components/LeadForm.astro';
import { SERVICES } from '../../data/services';
import { serviceExtra, serviceLabel } from '../../data/extras';
import { fill, prices, usd } from '../../data/business';
---
<Base
  title="Samsung Refrigerator Repair Services | Southern California"
  description={`In-home Samsung refrigerator repairs: not cooling, ice maker, leaks, freezer, compressor, control board, door seals, noise, error codes. ${usd(prices.diagnostic)} diagnostic.`}
  crumbs={[{ label: 'Repairs' }]}
>
  <section class="section">
    <div class="wrap">
      <h1>Samsung refrigerator repairs</h1>
      <p class="lede">Pick the symptom. Each page covers what usually fails on Samsung units, what you can check yourself, and how we repair it.</p>
      <div class="grid grid-3">
        {SERVICES.map((s) => (
          <a class="card pcard" href={`/services/${s.slug}/`}>
            <Photo id={serviceExtra[s.slug].photos[0]} sizes="(min-width: 900px) 33vw, 100vw" />
            <h2 class="h3">{serviceLabel(s.slug)}</h2>
            <p class="note">{fill(s.shortDescription)}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  <LeadForm />
</Base>

<style>
  .pcard { padding: 0; overflow: hidden; }
  .pcard :global(img) { border-radius: 0; aspect-ratio: 4 / 3; object-fit: cover; }
  .pcard .h3 { font-size: 1.15rem; padding: 14px 16px 0; margin: 0 0 .3em; }
  .pcard p { padding: 0 16px 16px; }
  .grid { margin-top: 20px; }
</style>
