---
import { business } from '../data/business';
---
{/* Phones only: the two actions that make a lead, always under the thumb. */}
<div class="mbar" role="complementary" aria-label="Contact">
  <a class="btn btn-light" href={`tel:${business.phone.tel}`}>Call {business.phone.display}</a>
  <a class="btn btn-primary" href="/book/">Book online</a>
</div>

<style>
  .mbar { display: none; }
  @media (max-width: 720px) {
    .mbar { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; padding: 8px 10px calc(8px + env(safe-area-inset-bottom)); background: var(--ink); box-shadow: 0 -4px 14px rgba(0,0,0,.18); }
    .mbar .btn { min-height: 46px; padding: 0 8px; font-size: .95rem; }
    :global(body) { padding-bottom: 70px; }
  }
</style>
