---
import { business, disclaimer, diagnosticText, warranty } from '../data/business';
import { COUNTIES } from '../data/locations';
import { SERVICES } from '../data/services';
import { serviceLabel } from '../data/extras';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer-grid">
    <div>
      <div class="logo">Samsung Fridge <b>Repair</b></div>
      <p class="note">In-home Samsung refrigerator repair across Southern California. {diagnosticText}. {warranty.short}.</p>
      <p><a class="mono big" href={`tel:${business.phone.tel}`}>{business.phone.display}</a><br /><span class="note">{business.hours.display}. Online requests any time.</span></p>
    </div>
    <div>
      <h3>Repairs</h3>
      <ul>
        {SERVICES.map((s) => <li><a href={`/services/${s.slug}/`}>{serviceLabel(s.slug)}</a></li>)}
      </ul>
    </div>
    <div>
      <h3>Service area</h3>
      <ul>
        {COUNTIES.map((c) => <li><a href={`/service-area/${c.slug}/`}>{c.name}</a></li>)}
      </ul>
      <h3 class="mt">More</h3>
      <ul>
        <li><a href="/error-codes/">Error codes</a></li>
        <li><a href="/models/">Models we service</a></li>
        <li><a href="/about/">About us</a></li>
        <li><a href="/book/">Book a repair</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap note copy">
    <p>{disclaimer}</p>
    <p>© {year} {business.brand}</p>
  </div>
</footer>

<style>
  .footer { background: var(--ink); color: #c9d1dc; padding: 48px 0 24px; margin-top: 40px; }
  .footer a { color: #c9d1dc; text-decoration: none; }
  .footer a:hover { color: #fff; }
  .footer h3 { color: #fff; font-size: .95rem; }
  .footer h3.mt { margin-top: 1.4em; }
  .footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-size: .95rem; }
  .footer-grid { display: grid; gap: 28px; }
  @media (min-width: 760px) { .footer-grid { grid-template-columns: 1.6fr 1fr 1fr; } }
  .logo { font: 600 1.2rem/1 var(--font-body); color: #fff; margin-bottom: 12px; }
  .logo b { color: #ffa94d; }
  .big { font-size: 1.2rem; color: #fff !important; }
  .footer .note { color: #95a0b0; }
  .copy { margin-top: 32px; font-size: .82rem; }
</style>
