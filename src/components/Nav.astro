---
import { business } from '../data/business';

const links = [
  { href: '/services/', label: 'Repairs' },
  { href: '/error-codes/', label: 'Error codes' },
  { href: '/models/', label: 'Models' },
  { href: '/service-area/', label: 'Service area' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
---
<header class="nav">
  <div class="wrap nav-row">
    <a class="logo" href="/" aria-label={`${business.brand} home`}>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M11 2h2v4.6l3.3-1.9 1 1.7L14 8.3l3.3 1.9-1 1.7L13 10v4l3.3 1.9 3.3-1.9 1 1.7L17.3 17.6l3.3 1.9-1 1.7-3.3-1.9V22h-2v-4.6L11 19.3V22H9v-2.7l-3.3 1.9-1-1.7L8 17.6 4.7 15.7l1-1.7L9 15.9v-3.8L5.7 10 2.4 11.9l-1-1.7L4.7 8.3 1.4 6.4l1-1.7L5.7 6.6 9 8.5v-.1L11 7.3z"/></svg>
      <span>Samsung Fridge <b>Repair</b></span>
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="nav-cta">
      <a class="phone mono" href={`tel:${business.phone.tel}`}>{business.phone.display}</a>
      <a class="btn btn-primary" href="/book/">Book a repair</a>
    </div>
  </div>
</header>

<style>
  .nav { background: var(--ink); color: #fff; position: sticky; top: 0; z-index: 10; }
  .nav-row { display: flex; align-items: center; gap: 20px; min-height: 64px; flex-wrap: wrap; padding-top: 8px; padding-bottom: 8px; }
  .logo { display: flex; align-items: center; gap: 8px; font: 600 1.1rem/1 var(--font-body); text-decoration: none; color: #fff; }
  .logo svg { color: #74c0fc; }
  .logo b { color: #ffa94d; font-weight: 800; }
  /* Phones: the menu takes its own full-width row (flex-basis 100%, not flex:1 — see vacuum.repair 11.10.2026). */
  nav { flex: 1 1 100%; order: 3; overflow-x: auto; }
  nav ul { display: flex; gap: 18px; list-style: none; margin: 0; padding: 0; white-space: nowrap; }
  nav a { text-decoration: none; color: #c9d1dc; font-size: .95rem; }
  nav a:hover, nav a[aria-current='page'] { color: #fff; }
  .nav-cta { margin-left: auto; display: flex; align-items: center; gap: 14px; }
  .phone { text-decoration: none; font-size: .95rem; color: #fff; }
  .nav-cta .btn { min-height: 40px; padding: 0 16px; font-size: .95rem; }
  /* Phones: the bottom bar (MobileBar) carries call + book, so the header shrinks to logo + menu and stops being sticky. */
  @media (max-width: 720px) { .nav { position: static; } .nav-cta { display: none; } .nav-row { gap: 10px; min-height: 0; } }
  @media (min-width: 980px) { nav { flex: 1 1 0%; order: 0; } }
</style>
