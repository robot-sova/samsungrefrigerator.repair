---
interface Props {
  items: { q: string; a: string }[];
  heading?: string;
}
const { items, heading = 'Questions people ask' } = Astro.props;
---
{items.length > 0 && (
  <section class="section">
    <div class="wrap prose">
      <h2>{heading}</h2>
      {items.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
)}
